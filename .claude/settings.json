{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(conda *)",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/check_conda_activation.sh",
            "statusMessage": "Conda..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'source /home/seuoh/miniforge3/etc/profile.d/conda.sh && conda activate videoprocess && cmake --build /home/seuoh/workspace/qt_ui/build' 2>/dev/null || true",
            "statusMessage": "Building..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "qt-development-skills@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
