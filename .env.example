# Copy this file to .env for local development, then adjust the paths for your machine.
#
# FFmpeg prefix used by CMake. The directory must contain include/libavformat
# and the FFmpeg libraries under lib/.
QT_UI_FFMPEG_PREFIX=/path/to/conda/env/or/ffmpeg/prefix

# Fallback names also accepted by CMake when QT_UI_FFMPEG_PREFIX is not set.
# FFMPEG_PREFIX=/path/to/ffmpeg/prefix
# CONDA_PREFIX=/path/to/conda/env

# WSLg/Wayland runtime directory. Leave unset on normal Linux desktop sessions
# unless the app cannot connect to the display.
# QT_UI_WSLG_RUNTIME_DIR=/mnt/wslg/runtime-dir

# Qt platform override used by src/main.cpp when QT_QPA_PLATFORM is empty.
# Common values: wayland, xcb, offscreen.
# QT_UI_QPA_PLATFORM=wayland

# Qt scene graph backend override used by src/main.cpp when QSG_RHI_BACKEND is empty.
# Common values: opengl, vulkan, metal, d3d11.
# QT_UI_QSG_RHI_BACKEND=opengl

# Test/headless override. This is usually set by CTest for GUI-related tests.
# QT_QPA_PLATFORM=offscreen
